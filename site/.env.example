# Projet Sanity (sanity.io/manage). Laisser vide pour afficher le contenu de référence.
NUXT_PUBLIC_SANITY_PROJECT_ID=
NUXT_PUBLIC_SANITY_DATASET=production
# Aperçu des derniers contenus Figma livrés dans le code : reference (sinon sanity).
NUXT_PUBLIC_CONTENT_SOURCE=sanity
# Jeton « Editor » (sanity.io/manage → API → Tokens) : enregistre les demandes du formulaire.
NUXT_SANITY_WRITE_TOKEN=
# Envoi des demandes par e-mail (créer une clé API sur resend.com).
NUXT_RESEND_API_KEY=
# Adresse d'envoi vérifiée dans Resend (ex. formulaire@votredomaine.fr).
NUXT_EMAIL_FROM=
# Destinataire des demandes du formulaire.
NUXT_CONTACT_EMAIL=collaborer@abritoi.com
# Origine publique HTTPS, sans chemin (ex. https://abritoi.com) pour les PDF par e-mail.
# Sans cette valeur, les documents restent disponibles en téléchargement uniquement.
NUXT_SITE_URL=

# Origine HTTPS des canonical, partages sociaux et sitemap (sans chemin/query/hash).
# Indépendante de NUXT_SITE_URL ci-dessus. Une valeur invalide revient à https://abritoi.com.
NUXT_PUBLIC_SEO_SITE_URL=https://abritoi.com
